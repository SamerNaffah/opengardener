# LLM Configuration
LLM_PROVIDER=ollama             # ollama | anthropic | openai
LLM_MODEL=llama3.2              # ollama: llama3.2, mistral | anthropic: claude-haiku-4-5-20251001 | openai: gpt-4o-mini
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ChromaDB (Soil vector store)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Gardener gRPC endpoints
SOIL_GRPC_HOST=gardener
SOIL_GRPC_PORT=50051
GARDENER_GRPC_HOST=gardener
GARDENER_GRPC_PORT=50052

# Soil behavior
SIMILARITY_THRESHOLD=0.7
MAX_TRAILS_PER_QUERY=5

# Gardener observer interval (seconds)
OBSERVER_INTERVAL_SECS=60

# Pruning thresholds (V1: logs only, no auto-kill)
PRUNE_FAILURE_RATE_THRESHOLD=0.7
PRUNE_MIN_TASKS=20
NICHE_MIN_TRAILS=10
NICHE_MAX_AGENTS=2
